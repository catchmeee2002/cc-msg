#!/usr/bin/env python3
"""cc-msg: 向运行中的 Claude Code 会话投递用户消息（UDS peer 通道）。

用法:
  cc-msg list [--json]
  cc-msg send <pid|name|session-id> <message>
  cc-msg send <pid|name|session-id> -        # 从 stdin 读消息
  cc-msg send <target> --from codex --reply-to <thread> <message>
"""

import argparse
import glob
import json
import os
import socket
import sys

SESS_DIR = os.path.expanduser("~/.claude/sessions")


def load_sessions():
    sessions = []
    for path in glob.glob(os.path.join(SESS_DIR, "*.json")):
        try:
            with open(path) as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        pid = d.get("pid")
        if not isinstance(pid, int) or not os.path.isdir(f"/proc/{pid}"):
            continue
        sock = d.get("messagingSocketPath")
        if not sock:
            continue
        d["_socket_ready"] = os.path.exists(sock)
        sessions.append(d)
    sessions.sort(key=lambda s: s.get("startedAt") or 0)
    return sessions


def fmt(s):
    return {
        "pid": s.get("pid"),
        "name": s.get("name") or "",
        "sessionId": s.get("sessionId") or "",
        "status": s.get("status") or "",
        "waitingFor": s.get("waitingFor") or "",
        "cwd": s.get("cwd") or "",
        "socket": s.get("messagingSocketPath") or "",
        "socketReady": s.get("_socket_ready", False),
    }


def resolve(sessions, target):
    exact = [s for s in sessions
             if str(s.get("pid")) == target
             or s.get("name") == target
             or s.get("sessionId") == target]
    if len(exact) == 1:
        return exact[0], None
    if len(exact) > 1:
        return None, "目标不唯一，请用 pid 或完整 session id"
    prefix = [s for s in sessions
              if (s.get("name") or "").startswith(target)
              or (s.get("sessionId") or "").startswith(target)]
    if len(prefix) == 1:
        return prefix[0], None
    if not prefix:
        live = ", ".join(f"{s.get('name')}({s.get('pid')})" for s in sessions) or "无"
        return None, f"找不到目标 {target!r}；当前活会话: {live}"
    names = ", ".join(f"{s.get('name')}({s.get('pid')})" for s in prefix)
    return None, f"目标 {target!r} 匹配到多个会话: {names}，请用 pid 指定"


def read_token(pid):
    keys = glob.glob(os.path.join(SESS_DIR, f"{pid}.*.key"))
    if len(keys) != 1:
        raise RuntimeError(f"密钥文件数量异常: {len(keys)}")
    with open(keys[0]) as f:
        tok = json.load(f).get("peerToken")
    if not tok:
        raise RuntimeError("密钥文件中没有 peerToken")
    return tok


def decorate(message, sender, reply_to):
    if not sender and not reply_to:
        return message
    parts = ["[跨会话消息"]
    if sender:
        parts.append(f" | 发送方: {sender}")
    if reply_to:
        parts.append(f' | 回复: codex queue --thread {reply_to} --message "..."')
    return "".join(parts) + "]\n\n" + message


def send_message(sess, message):
    sock_path = sess.get("messagingSocketPath")
    if not sock_path or not os.path.exists(sock_path):
        raise RuntimeError(f"目标 socket 不存在: {sock_path}")
    token = read_token(sess["pid"])
    wire = "\n".join([
        json.dumps({"type": "auth", "token": token}),
        json.dumps({"type": "user",
                    "message": {"role": "user", "content": message}}),
    ]) + "\n"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(5)
    try:
        s.connect(sock_path)
        s.sendall(wire.encode())
    finally:
        s.close()


def cmd_list(args):
    sessions = load_sessions()
    rows = [fmt(s) for s in sessions]
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return 0
    if not rows:
        print("没有运行中的 Claude Code 会话")
        return 0
    print(f"{'PID':<9} {'NAME':<26} {'STATUS':<10} {'WAITING':<14} CWD")
    for r in rows:
        print(f"{r['pid']:<9} {r['name'][:25]:<26} {r['status']:<10} "
              f"{r['waitingFor'][:13]:<14} {r['cwd']}")
    return 0


def cmd_send(args):
    sessions = load_sessions()
    sess, err = resolve(sessions, args.target)
    if err:
        print(f"cc-msg: {err}", file=sys.stderr)
        return 2
    if args.message == "-":
        message = sys.stdin.read()
    else:
        message = args.message
    if not message.strip():
        print("cc-msg: 消息为空", file=sys.stderr)
        return 2
    message = decorate(message, args.sender, args.reply_to)
    try:
        send_message(sess, message)
    except Exception as e:
        print(f"cc-msg: 投递失败: {e}", file=sys.stderr)
        return 1
    info = fmt(sess)
    if args.json:
        print(json.dumps({"ok": True, "target": info}, ensure_ascii=False))
    else:
        print(f"已投递 -> {info['name']}({info['pid']}) [{info['status']}]")
    return 0


def main():
    p = argparse.ArgumentParser(prog="cc-msg",
                                description="向运行中的 Claude Code 会话投递消息")
    sub = p.add_subparsers(dest="cmd", required=True)

    lp = sub.add_parser("list", help="列出可投递的会话")
    lp.add_argument("--json", action="store_true")
    lp.set_defaults(func=cmd_list)

    sp = sub.add_parser("send", help="投递消息")
    sp.add_argument("target", help="pid、会话名或 session id（支持前缀）")
    sp.add_argument("message", help="消息文本；传 - 表示从 stdin 读取")
    sp.add_argument("--from", dest="sender",
                    help="发送方标识，写入消息头")
    sp.add_argument("--reply-to",
                    help="回复用的 Codex thread（UUID 或名称），写入消息头")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_send)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
